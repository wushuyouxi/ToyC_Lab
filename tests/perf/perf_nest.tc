// 性能:嵌套循环(纯局部变量、常量边界 → 受限编译期求值折叠)
// s = sum_{i=1..100, j=1..100} (i*j) % 7,返回 s % 256
// expect: 25
int main() {
    int s = 0;
    int i = 1;
    while (i <= 100) {
        int j = 1;
        while (j <= 100) {
            s = s + (i * j) % 7;
            j = j + 1;
        }
        i = i + 1;
    }
    return s % 256;
}
