// 负数字面量二义性边界:1-2、1--2、a*-2、取模符号、INT_MIN
// expect: 5
int main() {
    int a = 1 - 2;            // -1
    int b = 1 - -2;           // 3
    int c = 5 * -2;           // -10
    int d = -7 % 3;           // -1(截断向零)
    int e = -2147483647 - 1;  // INT_MIN
    int z = 0;
    if (a == -1) z = z + 1;
    if (b == 3) z = z + 1;
    if (c == -10) z = z + 1;
    if (d == -1) z = z + 1;
    if (e == -2147483648) z = z + 1;
    return z;
}
