// 逻辑短路、if-else、break/continue、关系运算
// expect: 209(退出码限制 0~255)
int main() {
    int a = 5;
    int b = 0;
    int c = 1;
    if (b != 0 && a / b > 1) {  // 短路:a/b 不应被求值
        return -1;
    }
    if (b == 0 || a / b > 1) {  // 短路:a/b 不应被求值
        c = c + 1;              // c = 2
    }
    int i = 0;
    int s = 0;
    while (i < 10) {
        i = i + 1;
        if (i % 3 == 0) continue;
        if (i > 8) break;
        s = s + i;
    }
    // s = 1+2+4+5+7+8 = 27,c = 2 → 27*7 + 2*10 = 209
    return s * 7 + c * 10;
}
